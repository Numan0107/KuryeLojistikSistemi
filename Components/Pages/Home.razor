@page "/"
@rendermode InteractiveServer

<div class="container mt-4" style="max-width: 1000px; font-family: sans-serif;">
    <h2 class="text-center mb-4">🛵 Canlı Kurye Takip ve Dağıtım Paneli</h2>

    <div class="row text-center mb-4">
        <div class="col-md-4">
            <div class="p-3 bg-light border rounded shadow-sm">
                <h5>🛵 Toplam Kurye</h5>
                <h3 class="text-primary">@KuryelerListesi.Count</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-light border rounded shadow-sm">
                <h5>🟢 Boştaki Kurye</h5>
                <h3 class="text-success">@BostaKuryeSayisi</h3>
            </div>
        </div>
        <div class="col-md-4">
            <div class="p-3 bg-light border rounded shadow-sm">
                <h5>🚨 Dağıtımdaki Kurye</h5>
                <h3 class="text-danger">@DagitimdaKuryeSayisi</h3>
            </div>
        </div>
    </div>

    <div class="card p-4 mb-4 shadow-sm">
        <h4 class="mb-3">➕ Yeni Saha Kuryesi Tanımla</h4>
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold mb-1">Adı Soyadı</label>
                <input type="text" class="form-control" @bind="AdSoyadInput" oninput="this.value = this.value.replace(/[^a-zA-ZçÇğĞıİöÖşŞüÜ ]/g, '')" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold mb-1">Telefon Numarası</label>
                <input type="tel" class="form-control" @bind="TelefonInput" oninput="this.value = this.value.replace(/[^0-9]/g, ''); if(this.value.length > 11) this.value = this.value.slice(0, 11);" maxlength="11" />
            </div>
            <div class="col-md-4">
                <label class="form-label text-muted small fw-bold mb-1">Araç Türü</label>
                <select class="form-select" @bind="AracInput">
                    <option value="Motosiklet">Motosiklet</option>
                    <option value="Otomobil">Otomobil</option>
                    <option value="Elektrikli Bisiklet">Elektrikli Bisiklet</option>
                </select>
            </div>
            <div class="col-md-12 text-end">
                <button class="btn btn-primary px-5" @onclick="KuryeKaydet">Kuryeyi Sisteme Ekle</button>
            </div>
        </div>
    </div>

    <div class="card p-4 shadow-sm">
        <h4 class="mb-3">📜 Aktif Saha Kurye Listesi</h4>
        @if (KuryelerListesi.Count == 0)
        {
            <p class="text-muted text-center">Sistemde henüz tanımlı saha kuryesi bulunmamaktadır.</p>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-dark">
                        <tr>
                            <th>Kurye ID</th>
                            <th>👤 Adı Soyadı</th>
                            <th>📞 Telefon</th>
                            <th>🚲 Araç Türü</th>
                            <th>🚨 Canlı Durum</th>
                            <th>Aksiyon</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var kurye in KuryelerListesi)
                        {
                            <tr>
                                <td class="fw-bold text-secondary">#@kurye.Id</td>
                                <td class="fw-bold">@kurye.AdSoyad</td>
                                <td>@kurye.Telefon</td>
                                <td><span class="badge bg-secondary">@kurye.AracTuru</span></td>
                                <td>
                                    <span class="badge @(kurye.Durum == "Boşta" ? "bg-success" : "bg-danger")">
                                        @kurye.Durum
                                    </span>
                                </td>
                                <td>
                                    <button class="btn btn-sm btn-danger" @onclick="() => KuryeSil(kurye.Id)">❌ Çıkar</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>

@code {
    private List<Kurye> KuryelerListesi = new List<Kurye>();
    private string AdSoyadInput { get; set; } = string.Empty;
    private string TelefonInput { get; set; } = "0";
    private string AracInput { get; set; } = "Motosiklet";

    private int BostaKuryeSayisi => KuryelerListesi.Count(k => k.Durum == "Boşta");
    private int DagitimdaKuryeSayisi => KuryelerListesi.Count(k => k.Durum == "Dağıtımda");

    protected override void OnInitialized()
    {
        KuryeleriYukle();
    }

    private void KuryeleriYukle()
    {
        using var db = new LojistikDbContext();
        KuryelerListesi = db.Kuryeler.ToList();
    }

    private void KuryeKaydet()
    {
        if (string.IsNullOrWhiteSpace(AdSoyadInput) || string.IsNullOrWhiteSpace(TelefonInput) || TelefonInput == "0") return;

        using var db = new LojistikDbContext();
        var yeniKurye = new Kurye
        {
            AdSoyad = AdSoyadInput,
            Telefon = TelefonInput,
            AracTuru = AracInput,
            Durum = "Boşta"
        };

        db.Kuryeler.Add(yeniKurye);
        db.SaveChanges();

        KuryeleriYukle();
        AdSoyadInput = string.Empty;
        TelefonInput = "0";
    }

    private void KuryeSil(int id)
    {
        using var db = new LojistikDbContext();
        var silinecek = db.Kuryeler.FirstOrDefault(k => k.Id == id);
        if (silinecek != null)
        {
            db.Kuryeler.Remove(silinecek);
            db.SaveChanges();
            KuryeleriYukle();
        }
    }
}
